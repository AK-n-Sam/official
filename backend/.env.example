# Copy to .env and fill in. .env is git-ignored; never commit real values.

MONGO_URL=mongodb://localhost:27017
DB_NAME=nexusos
# Long random string; signs sign-in tokens and encrypts stored bank connection keys.
JWT_SECRET=change-me-to-a-long-random-string
# The demo owner account created on first start.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me
# The frontend's address (comma-separated if more than one).
CORS_ORIGINS=http://localhost:3000

# --- Live bank feeds (optional) ---
# Without these, the Bank page still works through statement import (CSV/OFX, any bank, free).
# Get keys at https://dashboard.plaid.com (Team Settings > Keys).
#   sandbox    = free test banks (sign in with user_good / pass_good)
#   production = real banks; free on Plaid's Trial plan for up to 10 connected banks (US & Canada)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Countries shown in the bank picker.
PLAID_COUNTRY_CODES=US,CA

# --- AI help (optional) ---
# Used for bank-category suggestions and the weekly summary. Without keys, both fall back to
# built-in rules and a standard template, so nothing stops working.
# Each variable takes one or more keys, comma-separated. Keys are rotated, rested when rate-limited,
# parked when out of quota, and quarantined if rejected; the next key or provider takes over.
# Keys stay on the server: they are never sent to the browser, stored in the database, or logged.
OPENAI_API_KEYS=
GEMINI_API_KEYS=
OPENROUTER_API_KEYS=
# Optional model overrides (defaults: gpt-4.1-mini, gemini-2.5-flash-lite, google/gemma-4-31b-it:free)
# OPENAI_MODEL=
# GEMINI_MODEL=
# OPENROUTER_MODEL=

# --- Background automation ---
# Scheduled jobs (overdue checks, repeating invoices, summaries, health checks) run inside the API
# process. Set to 1 to switch them off for this process (e.g. on extra API replicas).
AUTOMATION_DISABLED=0
